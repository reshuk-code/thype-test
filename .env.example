##############################################################################
# Copy this file to .env.local and fill in what your project actually needs.
#
# .env.local is gitignored. NEVER commit real credentials.
#
# Rule of thumb: anything prefixed NEXT_PUBLIC_ is shipped to the browser and
# is therefore public. Everything else stays on the server. The service-role
# key in particular must never gain that prefix — it bypasses row level
# security and would hand full database access to any visitor.
##############################################################################

# --- Core -------------------------------------------------------------------

# Public origin of the site. Used for canonical URLs, OG images and sitemap.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs admin session cookies. REQUIRED in production; the app refuses to boot
# without it. In development a secret is generated into .cms-data/ for you.
# Generate one:  npm run cms:secret
CMS_SESSION_SECRET=

# --- Backend selection ------------------------------------------------------
# THIS FILE IS THE ONLY PLACE BACKENDS ARE CONFIGURED. There is nothing to type
# into the admin; /admin/settings/connections just reports what it detects here.
#
#   CMS_DATABASE : local | supabase | postgres | neon | mongodb | firebase
#   CMS_STORAGE  : local | supabase | s3
#   CMS_AUTH     : credentials | supabase | neon | clerk
#
# CMS_DATABASE=supabase
# CMS_STORAGE=supabase
# CMS_AUTH=credentials

# --- Supabase ---------------------------------------------------------------
# Needed when CMS_DATABASE=supabase or CMS_STORAGE=supabase.
# Run adapters/supabase/schema.sql against the project once before first use.

SUPABASE_URL=
# Server-side only. Bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: prefix for CMS tables, so they can share a database with your own.
# SUPABASE_TABLE_PREFIX=cms_
# Optional: public storage bucket for the media library (default: media).
# SUPABASE_STORAGE_BUCKET=media

# Only set these if your frontend queries Supabase directly from the browser.
# The CMS itself does not need them.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Neon (serverless Postgres) ---------------------------------------------
# Needed when CMS_DATABASE=neon.
# Run adapters/neon/schema.sql in the Neon SQL Editor once before first use.
# Adapter status: verified against a live project (Thype runs on it).
# Hosting walkthrough: docs/DEPLOY-VERCEL-NEON.md.

# NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# NEON_TABLE_PREFIX=cms_

# --- Self-hosted Postgres ---------------------------------------------------
# Needed when CMS_DATABASE=postgres.
# Use this for Docker/VPS hosting. docker-compose.yml initialises the schema
# automatically for fresh databases; otherwise run adapters/postgres/schema.sql.

# POSTGRES_DATABASE_URL=postgresql://cms:change_me@postgres:5432/cms
# POSTGRES_TABLE_PREFIX=cms_

# --- MongoDB ----------------------------------------------------------------
# Needed when CMS_DATABASE=mongodb. Also run: npm install mongodb
# Adapter status: unverified. See docs/ROADMAP.md.

# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
# MONGODB_DB=cms

# --- Firebase ---------------------------------------------------------------
# Adapter status: NOT IMPLEMENTED. These names are reserved so a project does
# not have to invent its own later.

# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET=

# --- S3-compatible storage --------------------------------------------------
# Needed when CMS_STORAGE=s3. Neon Object Storage (verified), AWS S3,
# Cloudflare R2, DigitalOcean Spaces, MinIO. The bucket must allow anonymous
# reads: published HTML stores plain URLs, which a signed URL would outlive.
# Walkthrough for Neon: docs/DEPLOY-VERCEL-NEON.md.
#
# Neon: endpoint from Console → Connect → Storage (or the get_storage API);
# the key pair is a credential with storage:read + storage:write, where
# token_id is the access key and s3_secret_access_key is the secret.

# STORAGE_S3_ENDPOINT=https://br-xxxx.storage.c-4.ap-southeast-1.aws.neon.tech
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_S3_BUCKET=media
# STORAGE_S3_ACCESS_KEY_ID=nak_live_...
# Server-side only. Never prefix with NEXT_PUBLIC_.
# STORAGE_S3_SECRET_ACCESS_KEY=nsk_live_...
# Optional CDN or custom domain in front of the bucket. Defaults to
# <endpoint>/<bucket>. Read at build time for image optimisation.
# STORAGE_S3_PUBLIC_URL=

##############################################################################
# Authentication providers
#
# Whichever you pick, ROLES STAY IN THIS CMS. The provider proves who someone
# is; the CMS decides what they may do. Add each person under /admin/users with
# the email address they sign in with, or they will be refused.
##############################################################################

# --- Supabase Auth ----------------------------------------------------------
# Needed when CMS_AUTH=supabase. The anon key is enough — Supabase only has to
# verify the password, and the CMS issues its own session.
# Leave SUPABASE_AUTH_URL blank to reuse the Supabase database connection.

# SUPABASE_AUTH_URL=
# SUPABASE_AUTH_ANON_KEY=

# --- Neon Auth (Stack Auth) -------------------------------------------------
# Needed when CMS_AUTH=neon.

# NEON_AUTH_PROJECT_ID=
# NEON_AUTH_PUBLISHABLE_KEY=
# NEON_AUTH_SECRET_KEY=

# --- Clerk ------------------------------------------------------------------
# Needed when CMS_AUTH=clerk.
#
# Clerk owns the sign-in screen and the session, and its middleware starts
# before any CMS code runs, so CMS_AUTH=clerk must be set here too.

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxx
